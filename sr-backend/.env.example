# Local PostgreSQL (Homebrew default Unix socket)
DB_HOST=/tmp
DB_PORT=5432
DB_USER=gejiazhuo.1
DB_PASSWORD=
DB_NAME=LocalAIResumeDB
DB_SSLMODE=disable
DB_TIMEZONE=Asia/Shanghai

SERVER_ADDR=:8080
FRONTEND_URL=http://localhost:5173

# Production must replace both secrets with separate random values.
JWT_ACCESS_SECRET=local-dev-access-secret-change-me
JWT_REFRESH_SECRET=local-dev-refresh-secret-change-me
COOKIE_SECURE=false

# =========================
# Chat 模型：生成最终回答
# =========================
AI_CHAT_PROVIDER=deepseek
AI_CHAT_API_KEY=
AI_CHAT_BASE_URL=https://api.deepseek.com
AI_CHAT_MODEL=

# =========================
# Embedding 模型：RAG 检索
# =========================
AI_EMBEDDING_PROVIDER=qwen
AI_EMBEDDING_API_KEY=
AI_EMBEDDING_BASE_URL=
AI_EMBEDDING_MODEL=text-embedding-v4
AI_EMBEDDING_DIMENSIONS=1536

# =========================
# 公共配置
# =========================
AI_TIMEOUT_SECONDS=60
AI_POLISH_TIMEOUT_SECONDS=180
ASSISTANT_NAME=KK

RAG_ENABLED=true
RAG_VECTOR_TOP_K=20
RAG_KEYWORD_TOP_K=20
RAG_FINAL_TOP_K=5
RAG_VECTOR_MIN_SIMILARITY=0.45
RAG_RRF_K=60
KNOWLEDGE_PATH=../knowledge
